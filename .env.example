# Local defaults. This template contains no secrets; never commit your .env.
# Production: NODE_ENV=production, ADMIN_CODE must be 16-256 characters,
# and ALLOWED_ORIGINS must list your exact HTTPS site origins.
NODE_ENV=development
ADMIN_CODE=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# No proxy trust by default. On Render, verify the proxy path first.
# Prefer known proxy CIDRs. A hop count (1-5) is supported only for a verified
# fixed path where the trusted edge overwrites/appends forwarding headers.
# Never use true or blindly trust the leftmost X-Forwarded-For value.
TRUST_PROXY=false

# Optional PostgreSQL URL; on Render configure this as a secret.
# Use TLS with certificate/hostname verification (sslmode=verify-full),
# plus the provider CA when needed. Never disable certificate verification.
DATABASE_URL=
# Optional absolute JSON path INSIDE a persistent disk; blank uses local data/.
BANKS_FILE=
PORT=3000

# Per-process capacity. Keep one service instance while rooms live in memory.
MAX_PLAYERS_PER_ROOM=32
MAX_ROOMS=100
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=40
MAX_SESSIONS=5000
MAX_ADMIN_LOGIN_IPS=5000
HANDSHAKE_TIMEOUT_MS=10000

# Token buckets: capacity per socket, refilling continuously over this window.
# Room/answer/admin/upload capacities apply separately to each event name.
SOCKET_RATE_WINDOW_MS=10000
SOCKET_RATE_TOTAL=120
SOCKET_RATE_EVENT=60
SOCKET_RATE_ROOMS=10
SOCKET_RATE_ANSWERS=60
SOCKET_RATE_ADMIN=30
SOCKET_RATE_UPLOADS=6

SOCKET_EVENT_MAX_BYTES=8192
QUESTION_IMPORT_MAX_BYTES=500000
IMAGE_UPLOAD_MAX_BYTES=2097152
MAX_CONCURRENT_IMAGE_UPLOADS=2
# Leave blank for the smallest compatible transport budget: base64(image) +
# 1 KiB framing (2797228 bytes at the default image limit). Polling needs this
# extra space; application-level limits above also cover WebSocket events.
SOCKET_MAX_BUFFER_BYTES=
